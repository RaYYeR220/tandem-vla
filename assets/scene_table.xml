<mujoco model="tandem_table">
  <compiler angle="radian" autolimits="true"/>
  <option integrator="implicitfast" timestep="0.002" cone="elliptic" iterations="20" ls_iterations="30" impratio="10"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
    <map znear="0.01" zfar="12"/>
    <quality shadowsize="4096"/>
  </visual>

  <default>
    <default class="prop">
      <geom condim="4" friction="0.9 0.02 0.001" solref="0.008 1" solimp="0.95 0.99 0.001" density="600"/>
    </default>
    <default class="furniture">
      <geom condim="3" friction="0.8 0.01 0.001" rgba="0.55 0.42 0.30 1"/>
    </default>
  </default>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.35 0.42 0.52" rgb2="0.08 0.10 0.14"
      width="512" height="3072"/>
    <texture name="tabletex" type="2d" builtin="checker" rgb1="0.82 0.80 0.76" rgb2="0.74 0.72 0.68"
      width="512" height="512"/>
    <material name="tablemat" texture="tabletex" texrepeat="6 4" specular="0.15" shininess="0.15"
      reflectance="0.02"/>
    <material name="woodmat" rgba="0.50 0.37 0.26 1" specular="0.1" shininess="0.1"/>
    <material name="platemat" rgba="0.94 0.94 0.96 1" specular="0.35" shininess="0.5"/>
    <material name="mugmat" rgba="0.20 0.45 0.75 1" specular="0.3" shininess="0.4"/>
    <material name="bottlemat" rgba="0.20 0.60 0.40 1" specular="0.4" shininess="0.6"/>
    <material name="metalmat" rgba="0.78 0.79 0.82 1" specular="0.6" shininess="0.8"/>
    <material name="slotmat" rgba="0.30 0.55 0.85 0.22"/>
    <material name="zonemat" rgba="0.95 0.70 0.25 0.16"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.0 -0.35 1.10" dir="0 0.3 -1" directional="false" diffuse="0.7 0.7 0.68"
      specular="0.18 0.18 0.18" cutoff="60"/>
    <light name="fill" pos="-0.70 0.60 0.95" dir="0.6 -0.5 -1" directional="false" diffuse="0.35 0.35 0.40"
      specular="0.05 0.05 0.05" cutoff="70"/>
    <light name="rim" pos="0.75 0.70 0.90" dir="-0.6 -0.5 -1" directional="false" diffuse="0.30 0.32 0.35"
      specular="0.05 0.05 0.05" cutoff="70"/>

    <!-- Backdrop: recolored during domain randomization -->
    <body name="backdrop" pos="0 0.80 0.35">
      <geom name="backdrop_geom" type="box" size="1.10 0.01 0.55" rgba="0.30 0.33 0.38 1" contype="0"
        conaffinity="0" group="1"/>
    </body>

    <!-- Table: top surface is the z = 0 plane -->
    <body name="table" pos="0 0.12 -0.03">
      <geom name="table_top" type="box" size="0.50 0.34 0.03" material="tablemat" class="furniture"
        rgba="1 1 1 1"/>
      <geom name="table_leg_a" type="box" size="0.03 0.03 0.33" pos="-0.44 -0.28 -0.36" material="woodmat"
        class="furniture" contype="0" conaffinity="0" group="1"/>
      <geom name="table_leg_b" type="box" size="0.03 0.03 0.33" pos="0.44 -0.28 -0.36" material="woodmat"
        class="furniture" contype="0" conaffinity="0" group="1"/>
      <geom name="table_leg_c" type="box" size="0.03 0.03 0.33" pos="-0.44 0.28 -0.36" material="woodmat"
        class="furniture" contype="0" conaffinity="0" group="1"/>
      <geom name="table_leg_d" type="box" size="0.03 0.03 0.33" pos="0.44 0.28 -0.36" material="woodmat"
        class="furniture" contype="0" conaffinity="0" group="1"/>
    </body>

    <!-- Arm mounts. Both arms face +y (towards the far edge of the table). -->
    <site name="mount_left" pos="-0.20 -0.05 0.0" euler="0 0 1.5707963" size="0.006" rgba="0.9 0.3 0.3 0"/>
    <site name="mount_right" pos="0.20 -0.05 0.0" euler="0 0 1.5707963" size="0.006" rgba="0.3 0.3 0.9 0"/>

    <!-- ================= Cabinet with a sliding drawer (left-arm territory) ================= -->
    <body name="cabinet" pos="-0.34 0.18 0.0">
      <geom name="cab_back" type="box" size="0.085 0.008 0.027" pos="0 0.082 0.027" material="woodmat"
        class="furniture"/>
      <geom name="cab_side_l" type="box" size="0.008 0.090 0.027" pos="-0.077 0 0.027" material="woodmat"
        class="furniture"/>
      <geom name="cab_side_r" type="box" size="0.008 0.090 0.027" pos="0.077 0 0.027" material="woodmat"
        class="furniture"/>
      <!-- A lip, not a full lid: it covers the cutlery while the drawer is shut, and nothing
           more, so the arm has room to work in front of the cabinet. -->
      <geom name="cab_top" type="box" size="0.085 0.045 0.005" pos="0 0.005 0.059" material="woodmat"
        class="furniture"/>

      <body name="drawer" pos="0 0 0.006">
        <joint name="drawer_slide" type="slide" axis="0 -1 0" range="0 0.115" damping="3.5"
          frictionloss="0.22" armature="0.01"/>
        <geom name="drawer_floor" type="box" size="0.066 0.082 0.005" pos="0 0 0.005" material="woodmat"
          class="furniture"/>
        <geom name="drawer_wall_back" type="box" size="0.066 0.005 0.017" pos="0 0.077 0.022"
          material="woodmat" class="furniture"/>
        <geom name="drawer_wall_front" type="box" size="0.066 0.005 0.017" pos="0 -0.077 0.022"
          material="woodmat" class="furniture"/>
        <geom name="drawer_wall_l" type="box" size="0.005 0.082 0.017" pos="-0.061 0 0.022"
          material="woodmat" class="furniture"/>
        <geom name="drawer_wall_r" type="box" size="0.005 0.082 0.017" pos="0.061 0 0.022" material="woodmat"
          class="furniture"/>
        <!-- Handle: a thin horizontal bar the gripper can pinch -->
        <geom name="drawer_handle" type="capsule" fromto="-0.032 -0.110 0.034 0.032 -0.110 0.034"
          size="0.0055" material="metalmat" condim="4" friction="1.0 0.02 0.001" priority="2"/>
        <geom name="drawer_handle_stem_l" type="box" size="0.004 0.014 0.004" pos="-0.032 -0.096 0.034"
          material="metalmat" class="furniture" rgba="1 1 1 1"/>
        <geom name="drawer_handle_stem_r" type="box" size="0.004 0.014 0.004" pos="0.032 -0.096 0.034"
          material="metalmat" class="furniture" rgba="1 1 1 1"/>
        <site name="drawer_handle_site" pos="0 -0.110 0.034" size="0.004" rgba="1 0 0 0"/>
        <site name="drawer_tray_site" pos="0 -0.030 0.012" size="0.004" rgba="1 0 0 0"/>
      </body>
    </body>

    <!-- ================= Props (all start in left-arm territory) =================
         Every graspable feature is sized against the measured SO-101 jaw travel
         (~74 mm of tip-to-tip opening at a 1.0 rad jaw command). -->
    <body name="plate" pos="-0.16 0.16 0.018">
      <freejoint name="plate_free"/>
      <geom name="plate_geom" type="cylinder" size="0.024 0.018" material="platemat" class="prop"
        mass="0.042"/>
      <geom name="plate_rim" type="cylinder" size="0.031 0.0022" pos="0 0 0.0158" material="platemat"
        class="prop" mass="0.005" contype="0" conaffinity="0" group="1"/>
      <site name="plate_site" pos="0 0 0" size="0.004" rgba="1 0 0 0"/>
    </body>

    <!-- Tumbler: a ring of wall segments so poured particles actually land inside it. -->
    <body name="mug" pos="-0.21 0.09 0.029">
      <freejoint name="mug_free"/>
      <geom name="mug_floor" type="cylinder" size="0.022 0.0025" pos="0 0 -0.0265" material="mugmat"
        class="prop" mass="0.016"/>
      <replicate count="16" euler="0 0 22.5">
        <geom name="mug_wall" type="box" size="0.0035 0.0044 0.029" pos="0.0185 0 0" material="mugmat"
          class="prop" mass="0.0019"/>
      </replicate>
      <site name="mug_site" pos="0 0 0" size="0.004" rgba="1 0 0 0"/>
      <site name="mug_mouth" pos="0 0 0.029" size="0.004" rgba="0 1 0 0"/>
    </body>

    <!-- Carton: open-topped, holds the water particles. Deliberately narrow and filled
         close to the brim so a pour happens at a tilt the five-joint arm can actually reach. -->
    <body name="bottle" pos="-0.215 0.185 0.0302">
      <freejoint name="bottle_free"/>
      <geom name="bottle_floor" type="box" size="0.021 0.021 0.0025" pos="0 0 -0.0275" material="bottlemat"
        class="prop" mass="0.010"/>
      <geom name="bottle_wall_a" type="box" size="0.021 0.003 0.030" pos="0 0.018 0" material="bottlemat"
        class="prop" mass="0.009"/>
      <geom name="bottle_wall_b" type="box" size="0.021 0.003 0.030" pos="0 -0.018 0" material="bottlemat"
        class="prop" mass="0.009"/>
      <geom name="bottle_wall_c" type="box" size="0.003 0.015 0.030" pos="0.018 0 0" material="bottlemat"
        class="prop" mass="0.007"/>
      <geom name="bottle_wall_d" type="box" size="0.003 0.015 0.030" pos="-0.018 0 0" material="bottlemat"
        class="prop" mass="0.007"/>
      <site name="bottle_site" pos="0 0 0" size="0.004" rgba="1 0 0 0"/>
      <site name="bottle_spout" pos="0 0 0.030" size="0.004" rgba="0 1 0 0"/>
    </body>

    <!-- Cutlery starts inside the closed drawer -->
    <body name="spoon" pos="-0.355 0.135 0.0192">
      <freejoint name="spoon_free"/>
      <geom name="spoon_handle" type="box" size="0.040 0.0055 0.0032" material="metalmat" class="prop"
        mass="0.016"/>
      <geom name="spoon_bowl" type="ellipsoid" size="0.017 0.011 0.0042" pos="0.052 0 0.0" material="metalmat"
        class="prop" mass="0.008"/>
      <site name="spoon_site" pos="0 0 0" size="0.004" rgba="1 0 0 0"/>
    </body>

    <body name="fork" pos="-0.355 0.170 0.0192">
      <freejoint name="fork_free"/>
      <geom name="fork_handle" type="box" size="0.040 0.0055 0.0032" material="metalmat" class="prop"
        mass="0.016"/>
      <geom name="fork_head" type="box" size="0.016 0.010 0.0030" pos="0.052 0 0.0" material="metalmat"
        class="prop" mass="0.007"/>
      <site name="fork_site" pos="0 0 0" size="0.004" rgba="1 0 0 0"/>
    </body>

    <!-- Water: 10 particles that start inside the carton and can be poured out. -->
    <replicate count="10" sep="_">
      <body name="water" pos="-0.215 0.185 0.02">
        <freejoint name="water_free"/>
        <geom name="water" type="sphere" size="0.0055" rgba="0.35 0.70 0.95 0.95" mass="0.0022" condim="4"
          friction="0.25 0.005 0.0001" solref="0.006 1"/>
      </body>
    </replicate>

    <!-- ================= Place setting (right-arm territory) ================= -->
    <body name="setting_marks" pos="0 0 0">
      <geom name="slot_plate_mark" type="cylinder" size="0.036 0.0008" pos="0.27 0.14 0.0009"
        material="slotmat" contype="0" conaffinity="0" group="1"/>
      <geom name="slot_fork_mark" type="box" size="0.012 0.052 0.0008" pos="0.195 0.14 0.0009"
        material="slotmat" contype="0" conaffinity="0" group="1"/>
      <geom name="slot_spoon_mark" type="box" size="0.012 0.052 0.0008" pos="0.345 0.14 0.0009"
        material="slotmat" contype="0" conaffinity="0" group="1"/>
      <geom name="slot_mug_mark" type="cylinder" size="0.030 0.0008" pos="0.295 0.198 0.0009"
        material="slotmat" contype="0" conaffinity="0" group="1"/>
      <geom name="handoff_mark" type="cylinder" size="0.045 0.0008" pos="0.0 0.10 0.0009" material="zonemat"
        contype="0" conaffinity="0" group="1"/>
    </body>

    <site name="slot_plate" pos="0.27 0.14 0.006" size="0.004" rgba="0 0 1 0"/>
    <site name="slot_fork" pos="0.195 0.14 0.006" size="0.004" rgba="0 0 1 0"/>
    <site name="slot_spoon" pos="0.345 0.14 0.006" size="0.004" rgba="0 0 1 0"/>
    <site name="slot_mug" pos="0.295 0.198 0.032" size="0.004" rgba="0 0 1 0"/>
    <site name="handoff_zone" pos="0.0 0.10 0.115" size="0.004" rgba="1 0.6 0 0"/>

    <!-- ================= Cameras ================= -->
    <camera name="overhead" mode="fixed" pos="0.0 0.13 0.78" euler="0 0 0" fovy="58"/>
    <camera name="front" mode="fixed" pos="0.0 -0.62 0.46" euler="0.95 0 0" fovy="52"/>
    <camera name="cinematic" mode="fixed" pos="-0.52 -0.52 0.50" euler="0.92 0 -0.72" fovy="55"/>
  </worldbody>

</mujoco>
